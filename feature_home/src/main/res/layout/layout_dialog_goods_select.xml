<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="com.sy.feature_home.bean.ResGoodsMoreDetail" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/iv_goodsimage"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="40dp"
            imageUrl="@{data.image}"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:text="@{data.title}"
            app:layout_constraintLeft_toRightOf="@id/iv_goodsimage"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_goodsimage"
            tools:text="Apple Watch Series7智能手表GPS款4毫米星光色铝金属表壳星光色运动型表..." />

        <TextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24.5dp"
            android:textColor="#F6380D"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@id/tv_title"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:text="￥2999.00" />

        <TextView
            android:id="@+id/tv_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ff8d8d8d"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_goodsimage"
            app:layout_constraintRight_toRightOf="parent"
            tools:text="库存59" />

        <!-- 2. 规格选择区（动态添加规格组） -->
        <LinearLayout
            android:id="@+id/ll_spec_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_goodsimage" />

        <TextView
            android:id="@+id/tv_goods_sum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="购买数量"
            android:layout_marginTop="15dp"
            android:textColor="#ff333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_spec_container" />

        <ImageView
            android:id="@+id/iv_subtract"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="40dp"
            android:src="@mipmap/icon_subtract"
            app:layout_constraintBottom_toBottomOf="@id/tv_goods_sum"
            app:layout_constraintRight_toLeftOf="@id/iv_add"
            app:layout_constraintTop_toTopOf="@id/tv_goods_sum" />

        <TextView
            android:id="@+id/tv_select_sum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            app:layout_constraintLeft_toRightOf="@id/iv_subtract"
            app:layout_constraintRight_toLeftOf="@id/iv_add"
            app:layout_constraintTop_toTopOf="@id/iv_subtract" />

        <ImageView
            android:id="@+id/iv_add"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/icon_add"
            app:layout_constraintBottom_toBottomOf="@id/tv_goods_sum"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_goods_sum" />

        <!-- 中间：加入购物车按钮（示例） -->
        <TextView
            android:id="@+id/btn_add_cart"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginTop="93dp"
            android:background="@drawable/bg_shopcart"
            android:gravity="center"
            android:text="加入购物车"
            android:textColor="#F77422"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/btn_buy_now"
            app:layout_constraintTop_toBottomOf="@id/tv_goods_sum" />

        <!-- 右侧：立即购买按钮（示例） -->
        <TextView
            android:id="@+id/btn_buy_now"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:background="@drawable/bg_buy"
            android:gravity="center"
            android:text="立即购买"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintLeft_toRightOf="@id/btn_add_cart"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_add_cart" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>