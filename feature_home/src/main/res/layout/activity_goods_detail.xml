<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="detail"
            type="com.sy.feature_home.ui.goods.GoodsDetailViewModel" />
    </data>

    <!--CoordinatorLayout 有自己的布局规则，它主要通过 layout_gravity 来控制直接子视图的粗略位置（如 layout_gravity="bottom"-->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F6F6"
        tools:context=".ui.goods.GoodsDetailActivity">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:visibility="gone">

            <!-- 整个状态栏行（包含返回键和文本） -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                app:layout_collapseMode="parallax">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_back"
                    android:layout_width="68dp"
                    android:layout_height="28dp"
                    android:layout_marginLeft="10dp"
                    app:cardBackgroundColor="#ffffffff"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_back"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@mipmap/icon_back" />

                        <View
                            android:id="@+id/v_line"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginLeft="10dp"
                            android:background="#E7E7E7" />

                        <ImageView
                            android:id="@+id/iv_shortcutkey"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginLeft="10dp"
                            android:src="@mipmap/icon_shortcutkey" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_product"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="商品"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintLeft_toRightOf="@+id/cv_back"
                    app:layout_constraintRight_toLeftOf="@id/tv_comment"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_comment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="评价"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintLeft_toRightOf="@id/tv_product"
                    app:layout_constraintRight_toLeftOf="@id/tv_detail"
                    app:layout_constraintTop_toTopOf="@id/tv_product" />

                <TextView
                    android:id="@+id/tv_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="详情"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintLeft_toRightOf="@id/tv_comment"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_product" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_back2"
                    android:layout_width="68dp"
                    android:layout_height="28dp"
                    android:layout_marginLeft="10dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#00000000"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_back2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@mipmap/icon_back" />

                        <View
                            android:id="@+id/v_line2"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginLeft="10dp"
                            android:background="#E7E7E7" />

                        <ImageView
                            android:id="@+id/iv_shortcutkey2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginLeft="10dp"
                            android:src="@mipmap/icon_shortcutkey" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_pager2"
                    android:layout_width="match_parent"
                    android:layout_height="419dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_indicator"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_corner_8dp_black"
                    android:gravity="center"
                    android:text="1/1"
                    android:textColor="#ffffffff"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="@id/view_pager2"
                    app:layout_constraintRight_toRightOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ctl_detail"
                    android:layout_width="0dp"
                    android:layout_height="156dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_corner_8dp"
                    android:padding="12dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view_pager2">

                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@{detail.price}"
                        android:textColor="#fffe3000"
                        android:textSize="24sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="￥299.00" />

                    <TextView
                        android:id="@+id/tv_original_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@{detail.datas.original_price}"
                        android:textColor="#ffbbbbbb"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/tv_price"
                        app:layout_constraintLeft_toRightOf="@id/tv_price"
                        tools:text="￥389.00" />

                    <TextView
                        android:id="@+id/tv_sales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{detail.sale}"
                        android:textColor="#ffbbbbbb"
                        android:textSize="14sp"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_price"
                        app:layout_constraintTop_toTopOf="@id/tv_price"
                        tools:text="已售7" />

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@{detail.datas.title}"
                        android:textColor="#ff333333"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="@id/tv_price"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_price"
                        tools:text="漫步者(EDIFIER)HECATE G2专 业版USB7.1声道游戏耳机电..." />

                    <TextView
                        android:id="@+id/tv_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{detail.datas.subtitle}"
                        android:textColor="#ff8d8d8d"
                        android:textSize="13sp"
                        app:layout_constraintLeft_toLeftOf="@id/tv_price"
                        app:layout_constraintTop_toBottomOf="@id/tv_title"
                        tools:text="麦克风吃鸡耳机带线控" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ctl_service"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8.5dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_corner_8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ctl_skus">

                    <TextView
                        android:id="@+id/tv_guarantee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:text="保障"
                        android:textColor="#ffbbbbbb"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15.dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{detail.guarantee}"
                        android:textColor="#ff8d8d8d"
                        android:textSize="14sp"
                        app:layout_constraintLeft_toRightOf="@id/tv_guarantee"
                        app:layout_constraintRight_toLeftOf="@id/iv_more_1"
                        app:layout_constraintTop_toTopOf="@id/tv_guarantee"
                        tools:text="正品保障 · 7天无理由退换 · 退货运费险 · ..." />

                    <ImageView
                        android:id="@+id/iv_more_1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="12dp"
                        android:src="@mipmap/iocn_more_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ctl_skus"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8.5dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_corner_8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ctl_detail">

                    <TextView
                        android:id="@+id/tv_select"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:text="选择"
                        android:textColor="#ffbbbbbb"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15.dp"
                        android:text="请选择商品规格"
                        android:textColor="#ff8d8d8d"
                        android:textSize="14sp"
                        app:layout_constraintLeft_toRightOf="@id/tv_select"
                        app:layout_constraintTop_toTopOf="@id/tv_select" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="12dp"
                        android:src="@mipmap/iocn_more_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ctl_params"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8.5dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_corner_8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ctl_service">

                    <TextView
                        android:id="@+id/tv_param"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:text="参数"
                        android:textColor="#ffbbbbbb"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15.dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{detail.params}"
                        android:textColor="#ff8d8d8d"
                        android:textSize="14sp"
                        app:layout_constraintLeft_toRightOf="@id/tv_param"
                        app:layout_constraintRight_toLeftOf="@id/iv_more_2"
                        app:layout_constraintTop_toTopOf="@id/tv_param"
                        tools:text="型号·电池容量" />

                    <ImageView
                        android:id="@+id/iv_more_2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="12dp"
                        android:src="@mipmap/iocn_more_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ctl_comment_default"
                    android:layout_width="0dp"
                    android:layout_height="224dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_corner_8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ctl_params">

                    <TextView
                        android:id="@+id/tv_comment_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="16dp"
                        android:drawableLeft="@drawable/shap_detail_flag"
                        android:drawablePadding="10dp"
                        android:text="评价"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="（0）"
                        android:textColor="#ffbbbbbb"
                        android:textSize="14sp"
                        app:layout_constraintLeft_toRightOf="@id/tv_comment_"
                        app:layout_constraintTop_toTopOf="@id/tv_comment_" />

                    <ImageView
                        android:layout_width="132dp"
                        android:layout_height="100dp"
                        android:src="@mipmap/icon_default_comment"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ctl_comment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_corner_8dp"
                    android:minHeight="224dp"
                    android:visibility="gone"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ctl_comment_default">

                    <TextView
                        android:id="@+id/tv_comment_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="16dp"
                        android:drawableLeft="@drawable/shap_detail_flag"
                        android:drawablePadding="10dp"
                        android:text="评价"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="（0）"
                        android:textColor="#ffbbbbbb"
                        android:textSize="14sp"
                        app:layout_constraintLeft_toRightOf="@id/tv_comment_2"
                        app:layout_constraintTop_toTopOf="@id/tv_comment_2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:text="查看全部"
                        android:textColor="#E9B461"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/tv_comment_2"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_comment_2" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="4dp"
                        android:src="@mipmap/iocn_more_black"
                        app:layout_constraintBottom_toBottomOf="@id/tv_comment_2"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_comment_2" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_comment_2" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/v_barr"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ctl_comment_default" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ctl_detailpic"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_corner_8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/v_barr">

                    <TextView
                        android:id="@+id/tv_detail_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="16dp"
                        android:drawableLeft="@drawable/shap_detail_flag"
                        android:drawablePadding="10dp"
                        android:text="详情"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <WebView
                        android:id="@+id/web_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_detail_" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_imagedetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- elevation="4dp"  阴影，避免被滚动内容遮挡 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_status_bar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@color/white"
            android:elevation="4dp"
            android:layout_gravity="bottom">

            <!-- 中间：加入购物车按钮（示例） -->
            <TextView
                android:id="@+id/btn_add_cart"
                android:layout_width="105dp"
                android:layout_height="35dp"
                android:layout_marginLeft="15dp"
                android:paddingLeft="5dp"
                android:background="@drawable/bg_shopcart"
                android:text="加入购物车"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="#F77422"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@id/btn_buy_now"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 右侧：立即购买按钮（示例） -->
            <TextView
                android:id="@+id/btn_buy_now"
                android:layout_width="105dp"
                android:layout_height="35dp"
                android:layout_marginRight="12dp"
                android:paddingRight="10dp"
                android:paddingLeft="10dp"
                android:textSize="16sp"
                android:background="@drawable/bg_buy"
                android:gravity="center"
                android:text="立即购买"
                android:textColor="@color/white"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>