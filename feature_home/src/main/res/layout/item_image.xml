<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="MenuButtonDatas"
            type="java.util.List&lt;com.sy.network.bean.ResHomeItem.MenuButtonItem&gt;" />
        <variable
            name="ImageCubeDatas"
            type="java.util.List&lt;com.sy.network.bean.ResHomeItem.ImageCubeItem&gt;" />
        <variable
            name="srchttp"
            type="String" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_circle1"
            imageUrl="@{srchttp+MenuButtonDatas.get(0).src}"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:layout_marginTop="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_circle2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_circle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="耳机音箱"
            android:textColor="#ff333333"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            app:layout_constraintLeft_toLeftOf="@id/iv_circle1"
            app:layout_constraintRight_toRightOf="@id/iv_circle1"
            app:layout_constraintTop_toBottomOf="@id/iv_circle1" />

        <ImageView
            android:id="@+id/iv_circle2"
            imageUrl="@{srchttp+MenuButtonDatas.get(1).src}"
            android:layout_width="49dp"
            android:layout_height="49dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_circle1"
            app:layout_constraintRight_toLeftOf="@id/iv_circle3"
            app:layout_constraintTop_toTopOf="@id/iv_circle1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="笔记本"
            android:textColor="#ff333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@id/iv_circle2"
            app:layout_constraintRight_toRightOf="@id/iv_circle2"
            app:layout_constraintTop_toTopOf="@id/tv_circle1" />

        <ImageView
            android:id="@+id/iv_circle3"
            imageUrl="@{srchttp+MenuButtonDatas.get(2).src}"
            android:layout_width="49dp"
            android:layout_height="49dp"
            app:layout_constraintLeft_toRightOf="@id/iv_circle2"
            app:layout_constraintRight_toLeftOf="@id/iv_circle4"
            app:layout_constraintTop_toTopOf="@id/iv_circle1"  />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电脑"
            android:textColor="#ff333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@id/iv_circle3"
            app:layout_constraintRight_toRightOf="@id/iv_circle3"
            app:layout_constraintTop_toTopOf="@id/tv_circle1" />

        <ImageView
            android:id="@+id/iv_circle4"
            imageUrl="@{srchttp+MenuButtonDatas.get(3).src}"
            android:layout_width="49dp"
            android:layout_height="49dp"
            app:layout_constraintLeft_toRightOf="@id/iv_circle3"
            app:layout_constraintRight_toLeftOf="@id/iv_circle5"
            app:layout_constraintTop_toTopOf="@id/iv_circle1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="相机"
            android:textColor="#ff333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@id/iv_circle4"
            app:layout_constraintRight_toRightOf="@id/iv_circle4"
            app:layout_constraintTop_toTopOf="@id/tv_circle1" />

        <ImageView
            android:id="@+id/iv_circle5"
            imageUrl="@{srchttp+MenuButtonDatas.get(4).src}"
            android:layout_width="49dp"
            android:layout_height="49dp"
            app:layout_constraintLeft_toRightOf="@id/iv_circle4"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_circle1"  />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="智能手表"
            android:textColor="#ff333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@id/iv_circle5"
            app:layout_constraintRight_toRightOf="@id/iv_circle5"
            app:layout_constraintTop_toTopOf="@id/tv_circle1"  />

        <ImageView
            android:id="@+id/iv_square1"
            imageUrl="@{srchttp+ImageCubeDatas.get(0).src}"
            android:layout_width="174dp"
            android:layout_height="168dp"
            android:layout_marginTop="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/iv_square2"
            app:layout_constraintTop_toBottomOf="@id/tv_circle1"/>
        <ImageView
            android:id="@+id/iv_square2"
            imageUrl="@{srchttp+ImageCubeDatas.get(1).src}"
            android:layout_width="173dp"
            android:layout_height="80dp"
            android:layout_marginLeft="8dp"
            app:layout_constraintLeft_toRightOf="@id/iv_square1"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_square1"/>
        <ImageView
            android:id="@+id/iv_square3"
            imageUrl="@{srchttp+ImageCubeDatas.get(2).src}"
            android:layout_width="173dp"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="@id/iv_square2"
            app:layout_constraintTop_toBottomOf="@id/iv_square2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>