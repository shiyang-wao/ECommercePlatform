<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_login"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/tv_account_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="账号登录"
            android:textColor="#ff333333"
            android:textSize="18sp"
            android:layout_marginTop="28dp"
            android:layout_marginLeft="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/v_line"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:background="#E7E7E7" app:layout_constraintLeft_toRightOf="@id/tv_account_login"
            app:layout_constraintTop_toTopOf="@id/tv_account_login"
            app:layout_constraintBottom_toBottomOf="@id/tv_account_login"/>

        <TextView
            android:id="@+id/tv_sms_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="短信登陆"
            android:textColor="#8D8D8D "
            android:textSize="18sp"
            android:layout_marginLeft="16dp"
            app:layout_constraintLeft_toRightOf="@id/v_line"
            app:layout_constraintTop_toTopOf="@id/tv_account_login"/>

        <TextView
            android:id="@+id/tv_notice_forget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="如果未设置过密码，请点击忘记密码"
            android:textColor="#ffbbbbbb"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            app:layout_constraintLeft_toLeftOf="@id/tv_account_login"
            app:layout_constraintTop_toBottomOf="@id/tv_account_login"/>

        <TextView
            android:id="@+id/tv_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="账号"
            android:textColor="#ff333333"
            android:textSize="14sp"
            android:layout_marginTop="40dp"
            android:layout_marginLeft="8dp"
            app:layout_constraintLeft_toLeftOf="@id/tv_account_login"
            app:layout_constraintTop_toBottomOf="@id/tv_notice_forget"/>
        
        <EditText
            android:id="@+id/et_account"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:hint="请输入账号"
            android:background="@null"
            android:textSize="14sp"
            android:inputType="phone"
            android:layout_marginLeft="28dp"
            app:layout_constraintLeft_toRightOf="@id/tv_account"
            app:layout_constraintTop_toTopOf="@id/tv_account"
            app:layout_constraintBottom_toBottomOf="@id/tv_account"/>

        <TextView
            android:id="@+id/tv_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密码"
            android:textColor="#ff333333"
            android:textSize="14sp"
            android:layout_marginTop="40dp"
            app:layout_constraintLeft_toLeftOf="@id/tv_account"
            app:layout_constraintTop_toBottomOf="@id/tv_account"/>

        <EditText
            android:id="@+id/et_password"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:hint="请输入密码"
            android:background="@null"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:layout_marginLeft="28dp"
            app:layout_constraintLeft_toRightOf="@id/tv_password"
            app:layout_constraintTop_toTopOf="@id/tv_password"
            app:layout_constraintBottom_toBottomOf="@id/tv_password"/>

        <TextView
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:text="忘记密码"
            android:textColor="#ff8d8d8d"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginRight="20dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tv_account"
            app:layout_constraintTop_toTopOf="@id/tv_account"/>

        <TextView
            android:id="@+id/tv_login_button"
            android:layout_width="78dp"
            android:layout_height="28dp"
            android:text="登录"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_marginRight="20dp"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@drawable/bg_login_button"
            app:layout_constraintTop_toTopOf="@id/tv_password"
            app:layout_constraintBottom_toBottomOf="@id/tv_password"/>

        <TextView
            android:id="@+id/tv_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="立即注册"
            android:textColor="#ff8d8d8d"
            android:textSize="14sp"
            android:layout_marginTop="87dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_password"/>

        <CheckBox
            android:id="@+id/cb_agreen"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="116dp"
            android:button="@null"
            android:drawableLeft="@drawable/icon_custom_checkbox"
            android:gravity="center"
            android:text="请阅读并同意《用户协议》和《隐私政策》"
            android:textColor="#ff000000"
            android:textSize="13sp"
            android:drawablePadding="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_register" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>