<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ECommercePlatform" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- 自定义弹窗样式：去除标题栏、背景透明 -->
    <style name="FullScreenDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <!-- 去除默认标题栏 -->
        <item name="windowNoTitle">true</item>
        <!-- 背景透明（避免弹窗周围有默认边框或阴影） -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 弹窗进入/退出动画（可选） -->
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
        <!-- 弹窗宽度匹配屏幕（可选，也可在代码中设置） -->
        <!-- 关键：设置最小宽度为0（解除系统默认的最小宽度限制） -->
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>

    <!-- 可选：弹窗动画样式 -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>