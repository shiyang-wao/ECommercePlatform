<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="categoryThrid"
            type="com.sy.feature_categorize.bean.ResCategory.ResFirstCategory.ResSecondCategory.ResThirdCategory" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_goods"
            imageUrl="@{categoryThrid.image}"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@{categoryThrid.name}"
            android:textColor="#ff333333"
            android:textSize="12sp"
            app:layout_constraintLeft_toLeftOf="@id/iv_goods"
            app:layout_constraintRight_toRightOf="@id/iv_goods"
            app:layout_constraintTop_toBottomOf="@id/iv_goods"
            tools:text="被枕套毯" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>