<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="checkviewmodel"
            type="com.sy.feature_user.ui.checkout.CheckViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F6F6 "
        tools:context=".ui.checkout.CheckoutActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_back"
                android:layout_width="68dp"
                android:layout_height="28dp"
                android:layout_marginLeft="10dp"
                app:cardBackgroundColor="#ffffffff"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_back"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@mipmap/icon_back" />

                    <View
                        android:id="@+id/v_line"
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="10dp"
                        android:background="#E7E7E7" />

                    <ImageView
                        android:id="@+id/iv_shortcutkey"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="10dp"
                        android:src="@mipmap/icon_shortcutkey" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_cart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="收银台"
                android:textColor="#ff333333"
                android:textSize="18sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:text="@{checkviewmodel.payFee}"
                tools:text="￥2999.00"
                android:textColor="#fff6380d"
                android:textSize="24sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cv_back" />

            <TextView
                android:id="@+id/count_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@{checkviewmodel.countDownText}"
                tools:text="剩余支付时间 00:14:49"
                android:textColor="#ffbbbbbb"
                android:textSize="13sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_price" />

            <TextView
                android:id="@+id/pay_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="60dp"
                android:text="选择支付方式"
                android:textColor="#ff333333"
                android:textSize="13sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/count_down" />

            <ImageView
                android:id="@+id/iv_pay"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="29dp"
                android:src="@mipmap/icon_pay"
                app:layout_constraintLeft_toLeftOf="@id/pay_mode"
                app:layout_constraintTop_toBottomOf="@id/pay_mode" />

            <TextView
                android:id="@+id/tv_balance_payment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="余额支付"
                android:textColor="#ff333333"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_pay"
                app:layout_constraintLeft_toRightOf="@+id/iv_pay"
                app:layout_constraintTop_toTopOf="@id/iv_pay" />

            <TextView
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="@{checkviewmodel.money}"
                tools:text="余额: 411.00元"
                android:textColor="#ffbbbbbb"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_pay"
                app:layout_constraintRight_toLeftOf="@id/cb_check"
                app:layout_constraintTop_toTopOf="@id/iv_pay" />

            <CheckBox
                android:id="@+id/cb_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:button="@drawable/checkbox_pay_selector"
                android:checked="false"
                app:buttonTint="@null"
                app:layout_constraintBottom_toBottomOf="@id/iv_pay"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/iv_pay" />

            <View
                android:id="@+id/v_line_long"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="#DADADA"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_pay" />

            <TextView
                android:id="@+id/pay"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_login_button"
                android:gravity="center"
                android:text="立即支付"
                android:textColor="#ffffffff"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_line_long" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>